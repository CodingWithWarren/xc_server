# TEMPLATE ONLY — this file IS committed to git. Never put a real password,
# API key, or secret here; put those in .env (git-ignored).
#
# Copy to .env and fill in. See CLAUDE.md "Auth" for details.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=replace-with-64-hex-chars
DEV_MODE=true
# Comma-separated allow-list of THIS project's OAuth client IDs — the server
# accepts a Google ID token whose aud matches any of them. Each platform's SDK
# stamps a different aud (Android→web ID, iOS→iOS ID). Keep the web ID first:
# /auth/config serves GOOGLE_CLIENT_IDS[0] to the dashboard's sign-in button.
GOOGLE_CLIENT_IDS=your-web-client-id.apps.googleusercontent.com,your-android-client-id.apps.googleusercontent.com,your-ios-client-id.apps.googleusercontent.com

# --- Coach email digest (see CLAUDE.md "Coach email digest") -------------------
# One shared team mailbox that coach email is forwarded into. Leave COACH_IMAP_*
# blank to turn the feature off entirely: /coach-digest then answers 501 and the
# app hides the card.
#
# Gmail setup, in order: turn on 2-Step Verification -> create an App Password
# (NOT the account password) -> enable IMAP in Gmail Settings > Forwarding and
# POP/IMAP. Skipping either gives AUTHENTICATIONFAILED.
COACH_IMAP_HOST=imap.gmail.com
COACH_IMAP_PORT=993
COACH_IMAP_USERNAME=your-team-mailbox@gmail.com
# The real one goes in .env, not here. Gmail displays App Passwords as four
# groups of four; enter the 16 characters with no spaces.
COACH_IMAP_PASSWORD=your-16-char-app-password
# Comma-separated coach addresses, or bare domains like @school.edu. Blank means
# every message in the mailbox is summarized.
COACH_SENDERS=coach@school.edu
# Summarization runs through OpenRouter. Get a key at https://openrouter.ai/keys;
# without it, mail is still polled and stored but no digest is produced. Real key
# goes in .env, not here.
OPENROUTER_API_KEY=sk-or-v1-...
# Comma-separated, tried in order. Blank = the defaults in config.py, which are a
# cheap PAID model (needs account credit) with a ":free" model behind it so the
# digest survives an empty balance or a busy endpoint. The ":free" suffix is what
# makes a model cost nothing; dropping it starts billing.
# Free list: https://openrouter.ai/models?max_price=0
COACH_DIGEST_MODELS=
# Thinking off. On a reasoning model max_tokens covers thinking AND the answer,
# so a long window can spend the whole budget thinking and return nothing.
COACH_DIGEST_REASONING=off
# "deny" = only route to providers that don't collect prompts (coach email names
# students). Blank routes anywhere: more providers, so fewer failures — note it
# can also 404 a model outright if no provider meets the policy.
COACH_DIGEST_DATA_COLLECTION=deny
# Optional tuning (defaults shown).
COACH_POLL_INTERVAL_MINUTES=20
COACH_WINDOW_DAYS=14
COACH_MAX_MESSAGES=25
COACH_MAX_BODY_CHARS=4000
# Optional: dedicated key for encrypting the stored mailbox password. Derived
# from JWT_SECRET when blank.
COACH_MAILBOX_KEY=
